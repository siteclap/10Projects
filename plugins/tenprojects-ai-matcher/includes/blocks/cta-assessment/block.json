{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tenprojects/cta-assessment",
    "title": "Assessment CTA",
    "category": "tenprojects",
    "icon": "megaphone",
    "description": "Call-to-action block that links to the AI assessment page.",
    "textdomain": "tenprojects",
    "attributes": {
        "heading": {
            "type": "string",
            "default": "Find Your Perfect Home"
        },
        "subheading": {
            "type": "string",
            "default": ""
        },
        "button_text": {
            "type": "string",
            "default": "Find My Top 10"
        },
        "variant": {
            "type": "string",
            "default": "gradient",
            "enum": [ "gradient", "simple", "inline" ]
        }
    },
    "supports": {
        "html": false,
        "align": true
    },
    "render": "file:./render.php",
    "editorScript": "file:./edit.js"
}
