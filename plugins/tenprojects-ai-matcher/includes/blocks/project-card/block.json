{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tenprojects/project-card",
    "title": "Project Card",
    "category": "tenprojects",
    "icon": "admin-home",
    "description": "Displays a single project card with optional fit score badge.",
    "textdomain": "tenprojects",
    "attributes": {
        "project_id": {
            "type": "number",
            "default": 0
        },
        "show_score": {
            "type": "boolean",
            "default": false
        },
        "score": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "align": false
    },
    "render": "file:./render.php",
    "editorScript": "file:./edit.js"
}
