{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tenprojects/fit-score",
    "title": "Fit Score Badge",
    "category": "tenprojects",
    "icon": "awards",
    "description": "Displays a fit score badge with configurable score and size.",
    "textdomain": "tenprojects",
    "attributes": {
        "score": {
            "type": "number",
            "default": 0
        },
        "size": {
            "type": "string",
            "default": "medium",
            "enum": [ "small", "medium", "large" ]
        },
        "static": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": false
    },
    "render": "file:./render.php",
    "editorScript": "file:./edit.js"
}
