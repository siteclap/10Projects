{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "768px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        { "slug": "brand-primary", "color": "#1A56DB", "name": "Brand Primary" },
        { "slug": "brand-primary-dark", "color": "#1E40AF", "name": "Brand Primary Dark" },
        { "slug": "brand-primary-light", "color": "#3B82F6", "name": "Brand Primary Light" },
        { "slug": "brand-primary-pale", "color": "#DBEAFE", "name": "Brand Primary Pale" },
        { "slug": "brand-primary-bg", "color": "#EFF6FF", "name": "Brand Primary BG" },
        { "slug": "brand-accent", "color": "#F59E0B", "name": "Amber Gold" },
        { "slug": "brand-accent-dark", "color": "#D97706", "name": "Amber Dark" },
        { "slug": "brand-accent-light", "color": "#FDE68A", "name": "Amber Light" },
        { "slug": "brand-accent-pale", "color": "#FEF3C7", "name": "Amber Pale" },
        { "slug": "success", "color": "#10B981", "name": "Success" },
        { "slug": "success-light", "color": "#D1FAE5", "name": "Success Light" },
        { "slug": "warning", "color": "#D97706", "name": "Warning" },
        { "slug": "warning-bg", "color": "#FEF3C7", "name": "Warning BG" },
        { "slug": "danger", "color": "#EF4444", "name": "Danger" },
        { "slug": "danger-light", "color": "#FEE2E2", "name": "Danger Light" },
        { "slug": "info", "color": "#3B82F6", "name": "Info" },
        { "slug": "gray-900", "color": "#111827", "name": "Gray 900" },
        { "slug": "gray-800", "color": "#1F2937", "name": "Gray 800" },
        { "slug": "gray-700", "color": "#374151", "name": "Gray 700" },
        { "slug": "gray-600", "color": "#4B5563", "name": "Gray 600" },
        { "slug": "gray-500", "color": "#6B7280", "name": "Gray 500" },
        { "slug": "gray-400", "color": "#9CA3AF", "name": "Gray 400" },
        { "slug": "gray-300", "color": "#D1D5DB", "name": "Gray 300" },
        { "slug": "gray-200", "color": "#E5E7EB", "name": "Gray 200" },
        { "slug": "gray-100", "color": "#F3F4F6", "name": "Gray 100" },
        { "slug": "gray-50", "color": "#F9FAFB", "name": "Gray 50" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" },
        { "slug": "section-alt", "color": "#F8FAFC", "name": "Section Alt BG" }
      ],
      "defaultPalette": false,
      "defaultGradients": false,
      "gradients": [
        {
          "slug": "hero",
          "gradient": "linear-gradient(135deg, #EFF6FF 0%, #F0F4FF 50%, #F8FAFC 100%)",
          "name": "Hero"
        },
        {
          "slug": "cta",
          "gradient": "linear-gradient(135deg, #1A56DB 0%, #1E40AF 100%)",
          "name": "CTA Blue"
        },
        {
          "slug": "fit-score",
          "gradient": "linear-gradient(135deg, #F59E0B, #E8930A)",
          "name": "Fit Score Gold"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
          "slug": "inter",
          "name": "Inter",
          "fontFace": [
            { "fontFamily": "Inter", "fontWeight": "400", "fontStyle": "normal", "src": ["file:./assets/fonts/inter-v18-latin-regular.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "500", "fontStyle": "normal", "src": ["file:./assets/fonts/inter-v18-latin-500.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "600", "fontStyle": "normal", "src": ["file:./assets/fonts/inter-v18-latin-600.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "700", "fontStyle": "normal", "src": ["file:./assets/fonts/inter-v18-latin-700.woff2"] },
            { "fontFamily": "Inter", "fontWeight": "800", "fontStyle": "normal", "src": ["file:./assets/fonts/inter-v18-latin-800.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "caption", "size": "12px", "name": "Caption" },
        { "slug": "small", "size": "14px", "name": "Small" },
        { "slug": "medium", "size": "16px", "name": "Medium" },
        { "slug": "body-large", "size": "18px", "name": "Body Large" },
        { "slug": "h4", "size": "18px", "name": "H4" },
        { "slug": "h3", "size": "22px", "name": "H3" },
        { "slug": "h2", "size": "28px", "name": "H2" },
        { "slug": "h1", "size": "36px", "name": "H1" },
        { "slug": "display", "size": "48px", "name": "Display" }
      ],
      "defaultFontSizes": false
    },
    "spacing": {
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        { "slug": "xs", "size": "4px", "name": "XS" },
        { "slug": "sm", "size": "8px", "name": "SM" },
        { "slug": "md", "size": "12px", "name": "MD" },
        { "slug": "lg", "size": "16px", "name": "LG" },
        { "slug": "xl", "size": "24px", "name": "XL" },
        { "slug": "2xl", "size": "32px", "name": "2XL" },
        { "slug": "3xl", "size": "48px", "name": "3XL" },
        { "slug": "4xl", "size": "64px", "name": "4XL" },
        { "slug": "5xl", "size": "96px", "name": "5XL" }
      ],
      "units": ["px", "em", "rem", "%", "vh", "vw"]
    },
    "border": {
      "radius": true,
      "color": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "presets": [
        { "slug": "card", "shadow": "0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04)", "name": "Card" },
        { "slug": "hover", "shadow": "0 10px 25px rgba(0,0,0,0.08), 0 4px 10px rgba(0,0,0,0.04)", "name": "Hover" },
        { "slug": "dropdown", "shadow": "0 4px 16px rgba(0,0,0,0.12)", "name": "Dropdown" }
      ]
    },
    "custom": {
      "borderRadius": {
        "sm": "8px",
        "md": "12px",
        "lg": "16px",
        "xl": "20px",
        "full": "9999px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "#FFFFFF",
      "text": "#111827"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "16px",
      "lineHeight": "1.5"
    },
    "spacing": {
      "padding": {
        "left": "var(--wp--preset--spacing--2-xl)",
        "right": "var(--wp--preset--spacing--2-xl)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "#1A56DB"
        },
        ":hover": {
          "color": {
            "text": "#1E40AF"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "700"
        },
        "color": {
          "text": "#111827"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "36px",
          "lineHeight": "1.22",
          "letterSpacing": "-0.01em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "28px",
          "lineHeight": "1.29",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "22px",
          "lineHeight": "1.36",
          "fontWeight": "600"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "18px",
          "lineHeight": "1.44",
          "fontWeight": "600"
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "15px",
          "fontWeight": "600",
          "lineHeight": "1"
        },
        "color": {
          "background": "#1A56DB",
          "text": "#FFFFFF"
        },
        "border": {
          "radius": "8px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        ":hover": {
          "color": {
            "background": "#1E40AF"
          }
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "project-card", "title": "Project Card", "area": "uncategorized" }
  ],
  "customTemplates": [
    { "name": "page-start", "title": "AI Assessment", "postTypes": ["page"] },
    { "name": "page-results", "title": "Results Page", "postTypes": ["page"] },
    { "name": "page-compare", "title": "Comparison Page", "postTypes": ["page"] },
    { "name": "page-dashboard", "title": "Customer Dashboard", "postTypes": ["page"] },
    { "name": "page-methodology", "title": "Methodology", "postTypes": ["page"] }
  ]
}
